# Oracle Training Docker Image
# 包含完整的训练环境：server, proxy, actor, game client
# 使用 TensorFlow 1.15 + Python 3.8

FROM python:3.8-slim

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
RUN pip install --no-cache-dir \
    numpy==1.18.5 \
    tensorflow==1.15.5 \
    pyarrow==5.0.0 \
    pyzmq==22.3.0 \
    ws4py==0.5.1 \
    websockets

# 设置工作目录
WORKDIR /app

# 复制项目文件
COPY guandan_server /app/guandan_server
COPY oracle_proxy /app/oracle_proxy
COPY actor_n /app/actor_n

# 设置可执行权限
RUN chmod +x /app/guandan_server

# 暴露端口
# 23456: game server
# 23457: oracle proxy
# 5000-5001: learner (外部)
# 6000-6003: actor zmq
EXPOSE 23456 23457 6000 6001 6002 6003

# 启动脚本
COPY docker_train_instance.sh /app/
RUN chmod +x /app/docker_train_instance.sh

CMD ["/app/docker_train_instance.sh"]
